APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# OIDC (tenant SSO — matches LumApps tenant model)
OIDC_ISSUER=https://login.microsoftonline.com/{tenant_id}/v2.0
OIDC_JWKS_URL=https://login.microsoftonline.com/{tenant_id}/discovery/v2.0/keys
OIDC_AUDIENCE=api://microapp-verticalforge

# Pack signing key (HMAC for the demo; KMS in production)
PACK_SIGNING_SECRET=replace-me-with-kms-managed-key
